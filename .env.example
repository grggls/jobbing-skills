# Optional settings for the workspace .env file. All values have defaults.

# Written by `jobbing notion --home URL --tracker URL --interviews URL`.
# The `setup` skill runs that command for you.
NOTION_HOME_URL=
NOTION_TRACKER_URL=
NOTION_INTERVIEWS_URL=

# Minimum score (0-100) that the scan skill reports as a match.
SCORE_THRESHOLD=60

# Days without interview activity before the followup skill flags a company.
FOLLOWUP_THRESHOLD_DAYS=5
